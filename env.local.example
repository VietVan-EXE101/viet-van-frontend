# ============================================================
# .env.local.example — Copy thành .env.local, điền giá trị thực
# ============================================================

# URL Backend (ngrok hoặc localhost)
# Khi chạy ngrok: ngrok http 8000 → copy URL vào đây
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Ví dụ khi dùng ngrok ──
# NEXT_PUBLIC_API_URL=https://xxxx-xx-xx-xxx-xx.ngrok-free.app

# ── Khi deploy production ──
# NEXT_PUBLIC_API_URL=https://api.vietvan.com
